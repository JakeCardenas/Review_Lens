# Copy this file to .env.local and fill in your own values. Never commit real secrets.

# Postgres connection string, used only on the server.
# Supabase: Project > Connect > Transaction pooler (port 6543). Replace the password placeholder.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Sentiment provider: auto (default), basic or gemini.
# auto uses Gemini when GEMINI_API_KEY is set; otherwise Basic mode (a word list that runs on the server).
SENTIMENT_PROVIDER=auto

# Optional. Turns on AI mode with Google's Gemini API free tier. Create the key in Google AI Studio,
# in a Google Cloud project with no billing account linked. Masked review text is then sent to Google,
# which may use it to improve its products and may have people read it.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite. Must be one of the free-tier models listed in the README.
GEMINI_MODEL=
